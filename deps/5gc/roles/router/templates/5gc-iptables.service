[Unit]
Description=5GC iptables rules
After=network-online.target aether-5gc-macvlan.service{% for n in router_networks | sort(attribute='role', reverse=true) %} sys-subsystem-net-devices-{{ n.name | replace('-', '\\x2d') }}.device{% endfor %}

Wants=network-online.target{% for n in router_networks | sort(attribute='role', reverse=true) %} sys-subsystem-net-devices-{{ n.name | replace('-', '\\x2d') }}.device{% endfor %}

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/sbin/iptables-restore -n < /etc/iptables/5gc-rules.v4'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
