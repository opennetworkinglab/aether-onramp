[Unit]
After=network-online.target aether-5gc-macvlan.service
Wants=network-online.target

[Service]
Type=oneshot
{% for r in router_nat_rules %}
ExecStart=/bin/bash -c "/usr/sbin/iptables -t nat -C POSTROUTING -s {{ r.ue_ip_pool }} -o {{ r.egress }} -j MASQUERADE || /usr/sbin/iptables -t nat -A POSTROUTING -s {{ r.ue_ip_pool }} -o {{ r.egress }} -j MASQUERADE"
{% endfor %}

[Install]
WantedBy={% for n in router_networks if n.role == 'core' %}sys-subsystem-net-devices-{{ n.name | replace('-', '\\x2d') }}.device{% if not loop.last %} {% endif %}{% endfor %}
