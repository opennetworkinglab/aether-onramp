[Unit]
Description=Aether 5GC macvlan fallback interfaces
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
{% for v in router_vlans %}
ExecStart=-/bin/bash -c '/usr/sbin/ip link show {{ v.parent }} >/dev/null 2>&1 || /usr/sbin/ip link add link {{ v.iface }} name {{ v.parent }} type vlan id {{ v.vlan }}'
ExecStart=-/usr/sbin/ip link set {{ v.parent }} up
{% if v.host_gateway %}
ExecStart=-/usr/sbin/sysctl -w net/ipv4/conf/{{ v.parent }}/forwarding=1
{% endif %}
{% endfor %}
{% for n in router_networks %}
ExecStart=/bin/bash -c '/usr/sbin/ip link show {{ n.name }} >/dev/null 2>&1 || /usr/sbin/ip link add link {{ n.parent }} name {{ n.name }} type macvlan mode bridge'
ExecStart=/usr/sbin/ip addr replace {{ n.gateway }}/{{ n.prefix }} dev {{ n.name }}
ExecStart=/usr/sbin/ip link set {{ n.name }} up
ExecStart=-/usr/sbin/sysctl -w net.ipv4.conf.{{ n.name }}.forwarding=1
{% for u in router_nat_instances if u.core.network == n.name %}
ExecStart=/usr/sbin/ip route replace {{ u.ue_ip_pool }} via {{ u.core.ip }} dev {{ n.name }} onlink
{% endfor %}
{% endfor %}
{% for n in router_networks %}
ExecStop=-/usr/sbin/ip link del {{ n.name }}
{% endfor %}

[Install]
WantedBy=multi-user.target
